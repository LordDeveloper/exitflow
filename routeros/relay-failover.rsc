        "us-sjc"={"23.144.160.67|FGcXuLkvErFPiTPAjtJusTtbCoFkJOK8SXHwWOeNYUM=";"23.144.160.86|A/FGRjSdq2is0cFCBixLy5Htx5SYFXsVVs28Lv1wsCs=";"23.144.160.106|PHvr2i7PvHljrPvbMpSQikfksXJNA/tseNeplNv1Wn8=";"79.127.217.34|2q0LGwWvnV2qbNEAgOOHh4tvol5vGeQXJZDAbazCSBY=";"79.127.217.47|+UZsgTzYTdG3LvqpL+V9ZkwEMiFcls32YlpuI0cqDQ4=";"23.234.92.3|wbK8/hP/ZMr972OtanZxugSqUVt/sM/G9rnTiQ5YbSw=";"23.234.92.127|dCHtOy+ieOOMzgpZPr557dXygpmlj9RRNCAvUQvXj3I=";"23.234.93.3|HqWGqZbCgLxYLGHQG7P3jHYWQgc5p6ImqaxgqA97WCY=";"23.234.93.127|hQ/UqXflXztKM2T39HmQRPpPjWP8I2r9FMqnqFWy53M=";"23.234.94.3|v0CXmb+wIy1P+IbFA/1nYTB3KoDzFyW5k7n8vXoTxiY=";"23.234.94.127|sjWKL/W2+21cyjEBjtMd4TQQlWTsLTUN4skYOF7YgnU=";"23.234.95.3|IKhrTUlWJXlcH30jNV82mlWlj6NEre3PZffJ7MoT0zc=";"23.234.95.127|rIqRJ1o3UxvuwXj9B7VDquiTZ8BtQdab4wsb4F1L7l8="};
        "us-slc"={"23.234.112.3|tA/k8ouzYiVmgCRCF7TWibVzv5xRp3cgv9TJX66poGE=";"23.234.112.127|6hF/LLVCkxlW+mH6wFob5ZiDZNu2DqfEj82w8wzVnHY=";"23.234.113.3|Taa3TPPNUUcD3upveDHqpi9uaNHbeXzh6kX+sQUcM0s=";"23.234.113.127|+ru/ZmhgTYWNLyn3ZWuC57PMOU64yMfuWPZ5ow0XY3A=";"23.234.114.3|QkiwUWRNNtI+8YSK0SPCq6KeKPSohpX/8FbFZkx+uHg=";"23.234.114.127|Gv4GZOT46WQsTOAH4mYlauwFRxtpCX08BI0bzot5Piw=";"23.234.115.3|6pJrsejyhJLRotKdS+RCZez28/WqlOw6qEs1BbjQVSI=";"23.234.115.127|f7xT56F8RP9XDXW7UCxBcjgP+SAGyH+y2OZ4fieR4X8="};
        "us-txc"={"79.127.222.194|+OCONjBoN5RytiPy000VOzhZsiu1tSzecmc1hl/q8hI=";"79.127.222.207|mjv8qVNwhVKO0ePAI97CRil188uwdR/VR6ihcNY/hio="};
        "us-uyk"={"104.36.50.3|utm9eFUk8tH0j/dwKLJvlb6BRSfm3GZbomxr52ZDGn0=";"104.36.50.33|8Rh2Qc+vXTREhJb/RfCcpXS13U9xSqy4Pnw4+Wwt7iE="};
        "us-was"={"185.213.193.3|qD3AH8vI8MhEVc9+0+2O8zV0Gx9FfKdy7ri3Bnpzo10=";"185.213.193.127|2AvJGG4MJfnJMRSR6kcha9FZMMkhJM/AtktI5DSESSI="};
        "za-jnb"={"154.47.30.130|5dOGXJ9JK/Bul0q57jsuvjNnc15gRpSO1rMbxkf4J2M=";"154.47.30.143|lTq6+yUYfYsXwBpj/u3LnYqpLhW8ZJXQQ19N/ybP2B8="}
    }

    :global exitflowFailoverCursor
    :global exitflowFailoverLastSwitch
    :if ([:typeof $exitflowFailoverCursor] != "num") do={ :set exitflowFailoverCursor 0 }
    :if ([:typeof $exitflowFailoverLastSwitch] != "array") do={ :set exitflowFailoverLastSwitch [:toarray ""] }
    :local interfaces [/interface wireguard find where name~"^mv-wg-" and disabled=no]
    :local total [:len $interfaces]
    :if ($total = 0) do={ :return }
    :local batch $total
    :if ($batch > 6) do={ :set batch 6 }
    :local uptime [/system resource get uptime]

    :for step from=1 to=$batch do={
        :local offset ($exitflowFailoverCursor % $total)
        :set exitflowFailoverCursor (($offset + 1) % $total)
        :local ifaceId ($interfaces->$offset)
        :local iface [/interface wireguard get $ifaceId name]
        :local cityEnd [:find $iface "-wg-" 6]
        :local lastSwitch ($exitflowFailoverLastSwitch->$iface)
        :if (([:typeof $cityEnd] = "num") and (([:typeof $lastSwitch] != "time") or (($uptime - $lastSwitch) >= 5m))) do={
            :do {
                :local city [:pick $iface 6 $cityEnd]
                :local candidates ($catalog->$city)
                :local peers [/interface wireguard peers find where interface=$iface and disabled=no]
                :local defaults [/ip route find where routing-table=$iface and dst-address="0.0.0.0/0" and gateway=$iface and active=yes]
                :if (([:typeof $candidates] = "array") and ([:len $candidates] > 1) and ([:len $peers] = 1) and ([:len $defaults] = 1)) do={
                    :local peer [:pick $peers 0]
                    :local currentIP [:tostr [/interface wireguard peers get $peer endpoint-address]]
                    :local currentKey [/interface wireguard peers get $peer public-key]
                    :local currentPrefix ($currentIP . "/32")
                    :local currentRoutes [/ip route find where routing-table=main and dst-address=$currentPrefix and active=yes and disabled=no]
                    :if ([:len $currentRoutes] = 1) do={
                        :local uplink [/ip route get [:pick $currentRoutes 0] gateway]
                        :if (([/ping address=1.1.1.1 interface=$iface routing-table=$iface count=1] = 0) and ([/ping address=8.8.8.8 interface=$iface routing-table=$iface count=1] = 0)) do={
                            :local currentIndex -1
                            :for pos from=0 to=([:len $candidates] - 1) do={
                                :local candidate ($candidates->$pos)
                                :if ([:pick $candidate 0 [:find $candidate "|"]] = $currentIP) do={ :set currentIndex $pos }
                            }
                            :for next from=1 to=([:len $candidates]) do={
                                :local candidate ($candidates->(($currentIndex + $next) % [:len $candidates]))
                                :local sep [:find $candidate "|"]
                                :local newIP [:pick $candidate 0 $sep]
                                :local newKey [:pick $candidate ($sep + 1) [:len $candidate]]
                                :if (($newIP != $currentIP) and ([:len [/interface wireguard peers find where endpoint-address=$newIP or current-endpoint-address=$newIP]] = 0)) do={
                                    :local prefix ($newIP . "/32")
                                    :local existing [/ip route find where routing-table=main and dst-address=$prefix and disabled=no]
                                    :if ([:len $existing] = 0) do={
                                        /ip route add dst-address=$prefix gateway=$uplink routing-table=main comment="Mullvad endpoint via toTR"
                                    }
                                    :local targetRoutes [/ip route find where routing-table=main and dst-address=$prefix and active=yes and disabled=no]
                                    :if ([:len $targetRoutes] = 1) do={
                                        :if (([/ip route get [:pick $targetRoutes 0] gateway] = $uplink) and ([/interface wireguard get $ifaceId disabled] = false) and ([:tostr [/interface wireguard peers get $peer endpoint-address]] = $currentIP) and ([/interface wireguard peers get $peer public-key] = $currentKey)) do={
                                            /interface wireguard peers set $peer endpoint-address=$newIP endpoint-port=51820 public-key=$newKey
                                            :set ($exitflowFailoverLastSwitch->$iface) $uptime
                                            :log warning ("Exitflow relay failover: " . $iface . " " . $currentIP . " -> " . $newIP)
                                            :return
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            } on-error={ :log warning ("Exitflow relay failover could not check " . $iface) }
        }
    }
}
/system scheduler add name=exitflow-relay-failover interval=1m start-time=00:00:00 policy=read,write,test on-event="/system script run exitflow-relay-failover"
