# Exitflow relay failover for RouterOS v7 / CHR.
# Import after configuring at least one mv-wg-* interface with its own routing table.
{
    :local existingTask [/system scheduler find where name="exitflow-relay-failover"]
    :if ([:len $existingTask] > 0) do={ /system scheduler remove $existingTask }
    :local existingScript [/system script find where name="exitflow-relay-failover"]
    :if ([:len $existingScript] > 0) do={ /system script remove $existingScript }
}
/system script add name=exitflow-relay-failover policy=read,write,test source={
    :if ([/system script job print count-only where script="exitflow-relay-failover"] > 1) do={ :return }

